FROM ghcr.io/chartdb/chartdb@sha256:9385f1a72174a2cdba27036127a98474a0c941c3c795dcc15149884c09834460

# Salin konfigurasi Nginx hardened ke template (dipakai entrypoint.sh) dan default.conf
COPY sources/nginx_chartdb.conf /etc/nginx/conf.d/default.conf.template
COPY sources/nginx_chartdb.conf /etc/nginx/conf.d/default.conf

# Salin template autoload seeder mandiri dan skema ke dalam web root Nginx (SSoT Bake)
COPY sources/autoload.html /usr/share/nginx/html/autoload.html
COPY sources/bank_raya_unified_schema.json /usr/share/nginx/html/bank_raya_unified_schema.json
