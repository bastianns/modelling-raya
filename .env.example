# ==============================================================================
# Enterprise Data Modeling - Zero-Credential-Exposure Environment Configuration
# ==============================================================================

# ChartDB Service Configuration (Stateless)
CHARTDB_PORT=8080
CHARTDB_DISABLE_ANALYTICS=true
CHARTDB_HIDE_CLOUD=true

# Azimutt Service Configuration (Self-Hosted)
AZIMUTT_PORT=8000
AZIMUTT_HOST=localhost
AZIMUTT_SECRET_KEY_BASE=GENERATE_RANDOM_SECRET_KEY_BASE_AT_LEAST_64_CHARS

# Azimutt Internal PostgreSQL Backend Database (Isolated Topologi Internal)
AZIMUTT_DB_USER=azimutt_bank_admin
AZIMUTT_DB_PASSWORD=CHANGE_TO_SECURE_RANDOMLY_GENERATED_PASSWORD
AZIMUTT_DB_NAME=azimutt_metadata
